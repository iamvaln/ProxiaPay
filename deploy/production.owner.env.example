# The production environment, owner half — a template.
#
# The real file lives on the VPS at $HOME/proxiapay/.env.production.owner, is
# chmod 600, and is never committed. Copy this there and fill in every <…>.
# .env.production names it with OWNER_ENV_FILE.
#
# READ BY db, migrate AND backup ONLY. api and worker never receive it: they
# connect as the least-privilege role and hold neither the owner's password nor
# the bucket's keys nor the backup encryption key. Nothing in the shared file
# (deploy/production.env.example) belongs here, and nothing here belongs there; a
# test (apps/api/src/docs/production-env.test.ts) checks both.
#
# Values go in literally. Compose interpolates `$` in env files, so generate
# secrets with `openssl rand -hex` (letters and digits only).

# ── The database owner ─────────────────────────────────────────────────────
# Read by the postgres image on the FIRST boot to create the cluster, and by
# backup to reach the server. Changing the password later changes nothing in an
# existing volume.
POSTGRES_USER=proxiapay
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=proxiapay

# migrate and the one-shot CLIs (seed, create-admin, set-credentials) run as the
# owner. Same password as above.
DATABASE_URL=postgres://proxiapay:<the same as POSTGRES_PASSWORD>@db:5432/proxiapay

# The least-privilege role the api and the worker connect as. migrate creates it,
# sets its password, and re-applies its grants after every run; both variables or
# neither. The role may be neither this file's owner nor a superuser. Its password
# is the one in APP_DATABASE_URL in the shared file.
APP_DB_ROLE=proxiapay_app
APP_DB_PASSWORD=<generate: openssl rand -hex 24>

# ── Continuous backups (WAL-G to Cloudflare R2) ────────────────────────────
# Every WAL segment is encrypted with libsodium before it leaves the container,
# so R2 never holds the ledger in clear. Read by db (archive_command) and backup.
# The same prefix on a second server would make two histories fight in one
# place: a restored server is started with archiving OFF (docs/production-deployment.md).
WALG_S3_PREFIX=s3://pay-db-backups/proxiapay

# R2's S3 API: https://<account id>.r2.cloudflarestorage.com. The region is the
# literal `auto`. A bucket-scoped token (Object Read & Write on pay-db-backups
# alone), not the account's.
AWS_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=<R2 access key id>
AWS_SECRET_ACCESS_KEY=<R2 secret access key>

# The encryption key of the backups: openssl rand -base64 32
# WITHOUT IT EVERY BACKUP IS NOISE. Copy it offline before the first real
# transaction; it cannot be recovered from R2 or from the VPS after a loss of both.
# Without a key both scripts refuse to run rather than upload in clear.
WALG_LIBSODIUM_KEY=<generate>

# The base backup runs once a day at this hour (UTC, 0-23); a failed one is
# retried hourly. A fresh database gets its first base backup at once.
BACKUP_SCHEDULE_HOUR_UTC=2

# Pruning keeps the last BACKUP_RETAIN_FULL full backups AND every backup of the
# last BACKUP_RETAIN_DAYS days, whichever keeps more. 36 days, not 35, so that a
# full 35 days back is always restorable.
BACKUP_RETAIN_FULL=35
BACKUP_RETAIN_DAYS=36

# Seconds a base backup may take before it is reported as BACKUP FAILED (6 h).
BACKUP_PUSH_TIMEOUT=21600
