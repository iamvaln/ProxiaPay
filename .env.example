# Environment: production | sandbox. Governs the console band, origin requirements and which adapters may run.
PROXIAPAY_ENV=sandbox
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/proxiapay_dev
# Master key for envelope encryption (32 bytes, base64). Generate: openssl rand -base64 32
MASTER_KEY_BASE64=
# Blind-index key for payer identifier equality lookups (32 bytes, base64).
INDEX_KEY_BASE64=
# Number of trusted proxy hops in front of the API. 0 means the socket address is the client address.
TRUSTED_PROXY_HOPS=0
# Public origin of the console, used for cookie attributes and CORS.
CONSOLE_ORIGIN=http://localhost:5173
# Address alerts are emailed to during the collections stage (spec 16.2).
ALERT_EMAIL=ops@example.com
# SMTP is optional in development: alerts and codes are logged instead of sent when unset.
SMTP_URL=
LOG_LEVEL=info
